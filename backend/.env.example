# ── API documentation (Swagger) ──────────────────────────────────────────────
# Swagger UI and the generated OpenAPI spec are served at /api/docs. They are
# disabled by default when NODE_ENV=production so the full endpoint/DTO catalog
# is not exposed to unauthenticated users. Set SWAGGER_ENABLED=true to force
# them on (e.g. in a staging environment that runs with NODE_ENV=production).
# Leave unset to follow NODE_ENV: enabled outside production, disabled in it.
SWAGGER_ENABLED=

# ── Rate limiting (Redis) ────────────────────────────────────────────────────
# IP rate-limit counters are stored in Redis so that every replica shares the
# same state. Without this, each pod keeps its own in-process Map and an
# attacker can bypass the limit by round-robining across instances.
# REDIS_URL takes precedence; otherwise the host/port/db/password values below
# are used. In production a reachable shared Redis instance is required.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
RATE_LIMIT_REDIS_REQUIRED=true

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=stellarwave_user
DB_PASSWORD=stellarwave_password
DB_NAME=stellarwave
# SSL/TLS for the database connection. Set DB_SSL=true for managed Postgres
# providers that require encrypted connections. By default the server
# certificate is not verified (rejectUnauthorized: false), which encrypts the
# connection but does not pin the CA. To verify the server certificate, set
# DB_SSL_CA to the PEM-encoded CA certificate (e.g. the provider's CA bundle).
# When DB_SSL_CA is set, the CA is pinned and DB_SSL_REJECT_UNAUTHORIZED
# defaults to true; set it to false only to keep encryption without
# certificate verification.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA=

# Trusted Proxy Configuration
# Comma-separated list of proxy IPs/CIDRs whose X-Forwarded-For and X-Real-IP
# headers are trusted for client IP resolution. Leave empty to trust no proxies
# (headers ignored; the socket remote address is used). Only list proxies you
# control, otherwise clients can spoof their IP and bypass rate limiting.
# Values in X-Forwarded-For / X-Real-IP are validated as IP addresses and
# ignored unless the immediate peer matches this list.
# The auth rate limiter (login brute-force protection) resolves the client IP
# through this same trusted-proxy list; leaving it empty means X-Forwarded-For
# is ignored and the socket remote address is used.
TRUSTED_PROXIES=


# Ignored: the application never synchronizes the schema at boot, because
# TypeORM runs that step with concurrent queries on a single pooled client
# (#956). Apply schema changes with `npm run migration:run` instead.
TYPEORM_SYNCHRONIZE=false

# Auth rate limiting (fail-closed)
# When true, any cache/Redis error while checking or incrementing the auth
# rate-limit counter causes the request to be rejected (HTTP 503) instead of
# allowed. This keeps brute-force protection active during a cache outage.
# Set to false only if availability must take precedence over login security.
AUTH_RATE_LIMIT_FAIL_CLOSED=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h


# Stellar Network Configuration
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_ISSUER_SECRET_KEY=your_stellar_secret_key_here
STELLAR_ISSUER_PUBLIC_KEY=your_stellar_public_key_here

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth rate limiting (login brute-force protection)
# Maximum failed login attempts per client IP within the window below.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# Window length in seconds for the auth rate limit.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Sentry Configuration
SENTRY_DSN=https://your-key@sentry.io/project-id
ENABLE_SENTRY=false

# Auth rate limiting (fail-closed)
# When true, any cache/Redis error while checking or incrementing the auth
# rate-limit counter causes the request to be rejected (HTTP 503) instead of
# allowed. This keeps brute-force protection active during a cache outage.
# Set to false only if availability must take precedence over login security.
AUTH_RATE_LIMIT_FAIL_CLOSED=true

# Storage Configuration (S3/MinIO)
# Set STORAGE_REQUIRED=false to disable storage requirement.
# When unset, storage is treated as optional and startup logs a warning.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=stellar-cert
STORAGE_REQUIRED=false

# Audit Log Configuration
# Number of days to retain audit logs before automatic cleanup
# Cleanup runs daily at midnight
AUDIT_RETENTION_DAYS=90

# Auth rate limiting (login brute-force protection)
# Maximum failed login attempts per client IP within the window below.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# Window length in seconds for the auth rate limit.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── Rate limiting (continued) ────────────────────────────────────────────────
# Window length in seconds and max requests per IP within that window.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Auth rate limiting (fail-closed)
# When true, any cache/Redis error while checking or incrementing the auth
# rate-limit counter causes the request to be rejected (HTTP 503) instead of
# allowed. This keeps brute-force protection active during a cache outage.
# Set to false only if availability must take precedence over login security.
AUTH_RATE_LIMIT_FAIL_CLOSED=true

# Duplicate Detection Configuration
# Similarity threshold for duplicate detection (0.0 to 1.0)
DUPLICATE_DETECTION_THRESHOLD=0.7
# Enable fuzzy matching for duplicate detection
DUPLICATE_DETECTION_FUZZY_MATCHING=true
# Time window in days to check for duplicates (e.g., 30 = check last 30 days)
DUPLICATE_DETECTION_TIME_WINDOW_DAYS=30
# Field weights for similarity calculation (0.0 to 1.0)
DUPLICATE_DETECTION_EMAIL_WEIGHT=0.5
DUPLICATE_DETECTION_NAME_WEIGHT=0.3
DUPLICATE_DETECTION_TITLE_WEIGHT=0.2

# Bull Board (queue dashboard at /admin/queues)
# The dashboard is disabled in production unless BULL_BOARD_ENABLED=true.
# When enabled, it requires HTTP Basic auth with the credentials below.
BULL_BOARD_ENABLED=false
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=change_me_to_a_long_random_value

# Auth rate limiting (login brute-force protection)
# Maximum failed login attempts per client IP within the window below.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# Window length in seconds for the auth rate limit.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── Auth rate limiting (fail-closed) ─────────────────────────────────────────
# When true, any cache/Redis error while checking or incrementing the auth
# rate-limit counter causes the request to be rejected (HTTP 503) instead of
# allowed. This keeps brute-force protection active during a cache outage.
# Set to false only if availability must take precedence over login security.
AUTH_RATE_LIMIT_FAIL_CLOSED=true

# Auth rate limiting (fail-closed)
# When true, any cache/Redis error while checking or incrementing the auth
# rate-limit counter causes the request to be rejected (HTTP 503) instead of
# allowed. This keeps brute-force protection active during a cache outage.
# Set to false only if availability must take precedence over login security.
AUTH_RATE_LIMIT_FAIL_CLOSED=true

# ── Stellar anchoring ────────────────────────────────────────────────────────

# ── Stellar anchoring ────────────────────────────────────────────────────────
# Set to false to issue certificates off-chain only. Local and CI setups have
# no funded issuer key, and on-chain issuance re-throws on failure, so leaving
# this on without a key makes issuance fail. A request may also pass
# "skipStellar": true to skip anchoring for a single certificate.
# Set to true once STELLAR_ISSUER_SECRET_KEY holds a funded testnet key.
STELLAR_ANCHORING_ENABLED=false

# Auth rate limiting (login brute-force protection)
# Maximum failed login attempts per client IP within the window below.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
# Window length in seconds for the auth rate limit.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── Email ────────────────────────────────────────────────────────────────────
# Leave all of these unset in development and the app creates a throwaway
# Ethereal inbox on boot, logging a preview URL per message ("Email preview
# URL: ..."). Nothing reaches a real address, which is usually what you want
# locally. In production, unset means email is disabled, not queued.
#
# For real delivery, set EMAIL_HOST *and* EMAIL_USERNAME (both, or the SMTP
# branch is skipped). secure is derived: TLS is used only when port is 465.
#
# Brevo (free tier: 300 emails/day) — Brevo dashboard > SMTP & API > SMTP:
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_USERNAME=<the SMTP login shown there, e.g. 8a1b2c@smtp-brevo.com>
#   EMAIL_PASSWORD=<an SMTP key generated there — NOT your account password>
#   EMAIL_FROM=<a sender address you have verified in Brevo>
#
# EMAIL_FROM must be a sender Brevo has verified, or it rejects the message.
# EmailJS cannot be used here: it is a browser-side REST API and issues no
# SMTP credentials.
#
# EMAIL_SERVICE=sendgrid (or any SENDGRID_API_KEY) takes precedence over these.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# Auth rate limiting (fail-closed)
# When true, any cache/Redis error while checking or incrementing the auth
# rate-limit counter causes the request to be rejected (HTTP 503) instead of
# allowed. This keeps brute-force protection active during a cache outage.
# Set to false only if availability must take precedence over login security.
AUTH_RATE_LIMIT_FAIL_CLOSED=true
